# herdr-nvim configuration. Copy to the plugin config directory:
#   cp config.env.example "$(herdr plugin config-dir herdr-nvim)/config.env"
# Environment variables with the same names override these values.

# Neovim executable used for daemons and sidebar clients.
HERDR_NVIM_NVIM=nvim

# Which side of the tab the sidebar takes (full height): right or left.
# Your other panes are rebuilt in the remaining half.
HERDR_NVIM_SIDE=right

# Sidebar width as a fraction of the tab width (0.1 - 0.9).
HERDR_NVIM_WIDTH=0.45

# Extra arguments passed to the headless daemon, split on whitespace.
# Example: HERDR_NVIM_ARGS=-u ~/.config/nvim-herdr/init.lua
HERDR_NVIM_ARGS=

# When a tab (or workspace) closes, write modified buffers with :wall before
# stopping its daemon. Set to 0 to discard them instead. Either way a Herdr
# toast reports what happened.
HERDR_NVIM_SAVE_ON_CLOSE=1

# How long (ms) to wait between escalating shutdown steps
# (:qall -> :qall! -> SIGTERM -> SIGKILL) when a tab closes.
HERDR_NVIM_GRACE_MS=1500

# Maximum lines of code included per annotation when sending to an agent.
HERDR_NVIM_MAX_SNIPPET_LINES=80

# How long (ms) a command waits for the daemon registry lock.
HERDR_NVIM_LOCK_TIMEOUT_MS=3000

# File picker (prefix+f / :HerdrPickFile): pane lines scanned for file paths
# when the agent has no session log, and how many session-touched files the
# default (empty-query) view shows. Typing searches the whole repo.
HERDR_NVIM_PICKER_SCAN_LINES=300
HERDR_NVIM_PICKER_MAX_FILES=20
